# skillagent configuration — copy to `.env` in the repo root and fill in what you need.
# `.env` is git-ignored. Never commit real keys. All values below are examples/defaults.

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# One of: google | groq | openrouter | custom
SKILLAGENT_LLM_PROVIDER=groq
# Model id; empty = provider default (groq: qwen/qwen3.8-27b, google: gemma-4-31b-it,
# openrouter: google/gemma-4-31b-it:free). Groq is primary per the WP0 bake-off (ADR-026).
SKILLAGENT_LLM_MODEL=
# OpenAI-compatible base URL; empty = provider default. Required for provider=custom.
SKILLAGENT_LLM_BASE_URL=

# ---------------------------------------------------------------------------
# API keys (only the one for the active provider is needed)
# ---------------------------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Groq console: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Key for provider=custom (any OpenAI-compatible endpoint)
SKILLAGENT_CUSTOM_API_KEY=

# ---------------------------------------------------------------------------
# LLM gateway behaviour
# ---------------------------------------------------------------------------
# Per-call timeout in seconds
SKILLAGENT_LLM_TIMEOUT_S=30
# Retries on 429 / 5xx / timeouts / connection errors (exponential backoff + jitter)
SKILLAGENT_LLM_MAX_RETRIES=3
# Max concurrent in-flight LLM calls per process
SKILLAGENT_LLM_MAX_CONCURRENCY=4
# Max requests per rolling 60 s window (match your free-tier RPM); 0 disables the limiter
SKILLAGENT_LLM_RPM=20

# ---------------------------------------------------------------------------
# Agent limits (enforced in code)
# ---------------------------------------------------------------------------
# Max skills executed per request (assignment limit: 2); extra intents are reported as skipped
SKILLAGENT_MAX_SKILLS_PER_REQUEST=2
# Max steps run concurrently in one scheduler wave
SKILLAGENT_MAX_PARALLEL_STEPS=2
# Max scheduler waves (chain depth)
SKILLAGENT_MAX_WAVES=2
# Overall deadline for one request, seconds
SKILLAGENT_REQUEST_DEADLINE_S=90
# Max estimated input tokens per request; larger inputs get a polite limit message, no LLM call
SKILLAGENT_MAX_REQUEST_TOKENS=6000

# ---------------------------------------------------------------------------
# Router candidate selection (Top-K activates only above the threshold)
# ---------------------------------------------------------------------------
SKILLAGENT_ROUTER_TOP_K_THRESHOLD=12
SKILLAGENT_ROUTER_TOP_K=6

# ---------------------------------------------------------------------------
# Prompts & logging
# ---------------------------------------------------------------------------
# Pin prompt versions, e.g. "router=1,translator=2"; empty = highest available version
SKILLAGENT_PROMPT_VERSIONS=
# DEBUG | INFO | WARNING | ERROR | CRITICAL
SKILLAGENT_LOG_LEVEL=WARNING
